# ─────────────────────────────────────────────────────────────
# Anchor Strength — root environment example.
# Copy to `.env` and fill in. Each app also has its own .env.example.
# ─────────────────────────────────────────────────────────────

# Comma-separated list of allowed origins for CORS across services.
PUBLIC_URL=http://localhost:3000
API_URL=http://localhost:4000
CMS_URL=http://localhost:1337

# Database (matches docker-compose.yml defaults for local dev).
DATABASE_URL=postgresql://anchor:anchor@localhost:5432/anchor?schema=public

# Email (Resend in prod; Mailpit at localhost:1025 in dev).
RESEND_API_KEY=
EMAIL_FROM=hello@anchorstrength.fit
EMAIL_TO=anchorstrengthofficial@gmail.com

# Analytics
PLAUSIBLE_DOMAIN=
