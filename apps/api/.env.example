# Anchor Strength — NestJS API env example. Copy to `.env`.

# Server
PORT=4000
NODE_ENV=development

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Database (matches docker-compose.yml)
DATABASE_URL=postgresql://anchor:anchor@localhost:5432/anchor?schema=public

# Email (Resend in prod). For local dev, leave empty to use console logging,
# or point an SMTP relay at Mailpit (docker compose up mail).
RESEND_API_KEY=
EMAIL_FROM=Anchor Strength <hello@anchorstrength.fit>
EMAIL_TO=anchorstrengthofficial@gmail.com

# WhatsApp / phone for notifications (used to build click-to-chat links)
WHATSAPP_PHONE=919379066066
