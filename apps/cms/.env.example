# Anchor Strength — Strapi CMS env example. Copy to `.env`.

HOST=0.0.0.0
PORT=1337
PUBLIC_URL=http://localhost:1337

# App keys (generate with: openssl rand -base64 32) — change in production!
APP_KEYS=key1-please-change,key2-please-change
API_TOKEN_SALT=please-change-this-salt
ADMIN_JWT_SECRET=please-change-this-secret
TRANSFER_TOKEN_SALT=please-change-this-salt
JWT_SECRET=please-change-this-secret

# Database — sqlite for dev (zero setup), postgres for prod.
DATABASE_CLIENT=sqlite
# For postgres:
# DATABASE_CLIENT=postgres
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=5432
# DATABASE_NAME=anchor_cms
# DATABASE_USERNAME=anchor
# DATABASE_PASSWORD=anchor
