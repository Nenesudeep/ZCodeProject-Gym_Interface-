{
  "kind": "collectionType",
  "collectionName": "trainers",
  "info": {
    "singularName": "trainer",
    "pluralName": "trainers",
    "displayName": "Trainer",
    "description": "Coach profiles."
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "name": { "type": "string", "required": true, "maxLength": 80 },
