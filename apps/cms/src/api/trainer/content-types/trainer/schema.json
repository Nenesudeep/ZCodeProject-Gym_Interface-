    "certifications": { "type": "json", "description": "Array of certification strings" },
    "photo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "order": { "type": "integer", "default": 0 }
  }
}
