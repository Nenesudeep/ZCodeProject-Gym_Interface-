# Anchor Strength — Nuxt web app env example. Copy to `.env`.

# Backend API base URL (NestJS). Used server-side.
API_BASE_URL=http://localhost:4000

# Public API base URL — exposed to the browser. Origin only (no trailing slash,
# no `/api` suffix). Production: the Render URL, e.g. https://xxx.onrender.com
PUBLIC_API_BASE_URL=http://localhost:4000

# Plausible analytics domain (leave empty to disable analytics).
PLAUSIBLE_DOMAIN=

# Canonical site URL — used by sitemap, robots and canonical tags.
# Set to your real domain in production.
SITE_URL=https://anchorstrength.fit
