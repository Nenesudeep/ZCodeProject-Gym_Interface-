{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".output/**", ".nuxt/**", "dist/**", "build/**", ".vercel/**"],
      "env": [
        "API_BASE_URL",
        "PUBLIC_API_BASE_URL",
        "NUXT_API_BASE_URL",
        "NUXT_PUBLIC_API_BASE_URL",
        "SITE_URL",
        "PLAUSIBLE_DOMAIN",
        "VERCEL",
        "NITRO_PRESET"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "outputs": [],
      "dependsOn": ["^build"]
    },
    "test": {
      "outputs": ["coverage/**"]
    },
    "clean": {
      "cache": false
    }
  }
}
